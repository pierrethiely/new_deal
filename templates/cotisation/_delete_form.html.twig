<form method="post" action="{{ path('cotisation_delete', {'id': cotisation.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette cotisation ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ cotisation.id) }}">
    <button class="btn btn-outline-danger">Supprimer</button>
</form>
