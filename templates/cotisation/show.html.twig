{% extends 'base.html.twig' %}

{% block title %}Cotisation{% endblock %}

{% block body %}
    <h1>Cotisation</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Année</th>
                <th>Mois</th>
                <th>PMSS</th>
                <th>SMIC</th>
            </tr>
            <tr>
                <td>{{ cotisation.year }}</td>
                <td>{{ cotisation.month }}</td>
                <td>{{ cotisation.pmssAmount }}</td>
                <td>{{ cotisation.smicAmount }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('cotisation_index') }}">Retour à la liste</a>

    <a href="{{ path('cotisation_edit', {'id': cotisation.id}) }}">Modifier</a>

    {{ include('cotisation/_delete_form.html.twig') }}
{% endblock %}
